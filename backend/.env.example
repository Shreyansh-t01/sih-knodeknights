# Never commit the real connection URLs. Use distinct least-privileged users.
LEGACY_DATABASE_URL=
MIDDLEWARE_DATABASE_URL=

PORT=3000
CDC_CHANNEL=cdc_channel
# The property in new_data / old_data that holds the source-system identity.
LEGACY_ID_FIELD=id

# Leave DB_SSL unset when the URL contains its own sslmode option. For local PostgreSQL:
DB_SSL=false
# In hosted production, set DB_SSL=true and keep certificate verification enabled:
DB_SSL_REJECT_UNAUTHORIZED=true

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Semantic Mapping (requires ONNX runtime — optional)
ENABLE_SEMANTIC_MAPPING=false

# ============================================================
# RPA Microservice — Connector Layer
# ============================================================
# Base URL of the deployed RPA service (Playwright-based)
RPA_BASE_URL=https://rpa-bot-production.up.railway.app
# API key for authenticating with the RPA service (do NOT commit secrets)
RPA_API_KEY=

# Per-department connector type override.
# Default is API. Set to RPA for departments with no usable API.
# CONNECTOR_<DEPT_TOKEN>_TYPE=RPA
# RPA_BOT_ID_<DEPT_TOKEN>=<configured-bot-id>
# Example:
# CONNECTOR_REVENUE_DEPARTMENT_TYPE=RPA
# RPA_BOT_ID_REVENUE_DEPARTMENT=govbridge_login_bot_01
